[flake8]
# Plugins:
# ANN   : flake8-annotations
# B,B9  : flake8-bugbear
# C     : McCabe code complexity
# D     : flake8-docstrings
# DOC   : pydoclint (flake8 plugin, install with `pydoclint[flake8]`)
# F     : pyflakes
# W,E   : pycodestyle (pep8) warnings and errors
select = ANN,B,B9,C,D,DOC,E,F,W

exclude =

extend-ignore =
    # No self type annotation.
    ANN101,
    # No cls type annotation.
    ANN102,
    # Whitespace before colons. (for black)
    E203,
    # Line break before binary operator. (for black)
    W503,

per-file-ignores =
    # Unused imports in init files.
    **/__init__.py:F401
    # Dynamically typed expressions (typing.Any) in test files.
    tests/*:ANN401

max-complexity = 10
max-line-length = 94
black-config = ./shared/pyproject.toml

docstring-convention = google

# pydoclint: Require Args/Returns/Yields/Raises sections that match the signature.
# Type annotations carry the types, so docstrings shouldn't repeat them.
style = google
arg-type-hints-in-docstring = False
check-return-types = False
check-yield-types = False
skip-checking-short-docstrings = False
